#include <iostream>
#include <fstream>    // ifstream lives here
#include <string>
using namespace std;

int main()
{
    string fileName;
    cout << "Enter the file name: ";
    getline(cin, fileName);      

    ifstream inFile;
    inFile.open(fileName);      

    if (inFile.fail())           
    {
        cout << "Could not open " << fileName << endl;
        return 1;
    }

    


    inFile.close();
    return 0;
}